# Frontend configuration.
#
# IMPORTANT: anything prefixed with NEXT_PUBLIC_ is inlined into the browser
# bundle at BUILD time and is NOT secret. Never put credentials here.

# Local development defaults
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/telemetry

# Optional local hardware endpoint used by the "Hardware" option page mode.
# Defaults to http://localhost:8000 when omitted, so production can leave these
# unset and still offer a localhost option.
# NEXT_PUBLIC_LOCAL_API_URL=http://localhost:8000
# NEXT_PUBLIC_LOCAL_WS_URL=ws://localhost:8000/ws/telemetry

# Production (Vercel) values look like this - note the wss:// scheme, since a
# page served over https:// cannot open an insecure ws:// connection:
# NEXT_PUBLIC_API_URL=https://neural-bridge-api.onrender.com
# NEXT_PUBLIC_WS_URL=wss://neural-bridge-api.onrender.com/ws/telemetry
