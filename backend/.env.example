# Runtime configuration
NEURAL_BRIDGE_MODE=mock
NEURAL_BRIDGE_HOST=0.0.0.0
NEURAL_BRIDGE_PORT=8000

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000

# Optional regex for origins that cannot be listed (e.g. Vercel preview deploys)
# CORS_ORIGIN_REGEX=https://.*\.vercel\.app

# Optional shared secret required by POST /devices. Set it on any public
# deployment and provide the same value to the local bridge as
# NB_DEVICE_REGISTRATION_KEY.
# DEVICE_REGISTRATION_KEY=generate-with: python -c "import secrets; print(secrets.token_hex(32))"

# Generated secrets - backend only, never exposed to the browser
# SECRET_KEY=generate-with: python -c "import secrets; print(secrets.token_hex(32))"
# JWT_SECRET=generate-with: python -c "import secrets; print(secrets.token_hex(32))"

# AI orchestration (server-side only; never expose these as NEXT_PUBLIC_ values)
# GEMINI_API_KEY=your-key-here
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_TIMEOUT_SECONDS=8
# GEMINI_MAX_OUTPUT_TOKENS=160
# 0 disables Gemini "thinking" for fast, complete short replies; -1 omits it.
# GEMINI_THINKING_BUDGET=0
# INTENT_RATE_LIMIT_SECONDS=3
